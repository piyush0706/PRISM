# =============================================
# PRISM - Environment Configuration Template
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --------------------------------------------
# REQUIRED: Groq API Key
# Get yours free at: https://console.groq.com
# --------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --------------------------------------------
# REQUIRED: GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, pull_requests
# --------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here

# --------------------------------------------
# OPTIONAL: PostgreSQL Database URL
# Leave blank to use local SQLite (prism.db) — 
# great for local testing with zero setup!
# Format: postgresql://user:password@host:5432/dbname
# --------------------------------------------
DATABASE_URL=

# --------------------------------------------
# OPTIONAL: Server Port (default: 8080)
# --------------------------------------------
PORT=8080
